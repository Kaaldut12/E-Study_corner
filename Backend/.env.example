# Backend Environment Variables Template
# Copy this to .env for local development, or add these to your Vercel/cloud hosting environment settings.

PORT=3001
NODE_ENV=production

# Frontend Origin(s) for CORS - comma separated (e.g. https://your-project.vercel.app,http://localhost:5173)
FRONTEND_URL=https://your-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Data Store Mode ('mongo', 'hybrid', or 'strict' for pure DB)
DATA_STORE_MODE=mongo

# MongoDB Connection String (e.g. MongoDB Atlas cluster for cloud deployment)
# Local: mongodb://127.0.0.1:27017/e-study-corner
# Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/e-study-corner?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/e-study-corner?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace-with-a-strong-random-secret-key-in-production
JWT_EXPIRATION=24h

# Email Service (SMTP for Password Reset & Announcements)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# College / Institution Info
COLLEGE_NAME=National Institute of Technology & Advanced Studies

# Firebase (Optional)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# Seed User Credentials & Profiles (Configurable via dotenv)
SEED_DEFAULT_PASSWORD=Admin@123

# Super Admin Profile
SEED_SUPERADMIN_NAME=Platform Super Administrator
SEED_SUPERADMIN_FIRSTNAME=Super
SEED_SUPERADMIN_LASTNAME=Admin
SEED_SUPERADMIN_EMAIL=superadmin@estudy.com
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_SUPERADMIN_PHONE=9876543210
SEED_SUPERADMIN_DOB=1980-01-01
SEED_SUPERADMIN_ADDRESS=Administration Block, NITAS Campus
SEED_SUPERADMIN_DEPT=Administration & Platform Governance

