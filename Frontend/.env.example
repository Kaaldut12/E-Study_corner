# Frontend Environment Variables Template
# Copy this to .env (or configure in Vercel Project Settings -> Environment Variables)

# Backend API URL (Production example: https://your-backend.vercel.app/api or Render/VPS backend)
VITE_API_URL=http://localhost:3001/api

# Optional Firebase integration
VITE_FIREBASE_CONFIG_OPTIONAL=true

# Institutional & Project Credits (Configurable via dotenv)
VITE_COLLEGE_NAME=National Institute of Technology & Advanced Studies
VITE_COLLEGE_SHORT_NAME=NITAS
VITE_COLLEGE_DEPT=Department of Computer Science & Engineering
VITE_PROJECT_TEAM=Lead Engineering & Research Team
VITE_PROJECT_GUIDE=Dr. A. Sharma (Associate Professor)
VITE_PROJECT_HOD=Prof. R. K. Verma (Head of Department)
